# AeroTwin Frontend Environment Configuration Template

# FastAPI Server REST URL (Local Default)
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI Server WebSocket Stream URL (Local Default)
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry

# Set to true to bypass backend endpoints and run isolated client-side mock telemetry instead
VITE_USE_MOCK_TELEMETRY=false
